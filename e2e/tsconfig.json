{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,

    // TypeScript 7 does not pull in node_modules/@types automatically here, so the
    // Node globals this harness uses (process, console) need an explicit entry.
    "types": ["node"]
  },
  "include": ["src"]
}
